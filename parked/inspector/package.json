{
  "name": "@lunarhue/forms-inspector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@lunarhue/forms-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
