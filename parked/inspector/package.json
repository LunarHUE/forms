      "optional": true
    }
  },
  "devDependencies": {
    "@lunarhue/forms-schema": "workspace:*",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "valibot": "catalog:"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  }
}
