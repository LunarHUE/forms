---
/*
 * The desktop sidebar: the picker island, pinned at the top, and the static
 * nav, which scrolls. Hidden under 1024px, where MobileNav takes over.
 *
 * `switchable` marks one of several sidebars on a framework-free page;
 * shell.css shows the one matching html[data-framework] (React by default).
 */
import { FrameworkPicker } from "./FrameworkPicker";
import { NavTree } from "./NavTree";
import type { SidebarData } from "./sidebar";

interface Props extends SidebarData {
  currentSlug?: string;
  switchable?: boolean;
}

const { framework, version, items, groups, currentSlug, switchable = false } = Astro.props;
---

<aside
  class="sticky top-14 hidden h-[calc(100dvh-3.5rem)] w-70 shrink-0 flex-col border-r bg-sidebar text-sidebar-foreground lg:flex"
  data-sidebar
  data-sidebar-for={switchable ? framework : undefined}
>
  <div class="px-4 pt-5 pb-3">
    <FrameworkPicker client:idle items={items} framework={framework} version={version} />
  </div>
  <div data-sidebar-scroll class="scroll-fade-y min-h-0 flex-1 overflow-y-auto px-4 pt-4 pb-8">
    <NavTree groups={groups} currentSlug={currentSlug} />
  </div>
</aside>
