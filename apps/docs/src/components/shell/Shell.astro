---
/*
 * The site frame around every docs page: header, sidebar and the main area.
 * It renders Layout itself, so a page uses Shell instead of Layout.
 *
 *   <Shell
 *     title="Masks · React" description="..."
 *     framework="react" version="0.1.1" groups={sidebar} currentSlug="plugins/masks"
 *     alternates={alternates(pages, "plugins/masks", "0.1.1")}
 *   >
 *     ...page content...
 *   </Shell>
 *
 * Props:
 *   title, description, noindex, meta   passed to Layout.
 *   framework     the page's framework. Leave it out on framework-free pages
 *                 (errors, 404): Shell then builds a sidebar per framework
 *                 itself and shows the last-used one (React by default).
 *   version       the docs version; defaults to the latest.
 *   groups        the sidebar from `sidebar()`. Needed with `framework`,
 *                 ignored without it.
 *   currentSlug   marks the active nav item (`errors` on the errors page).
 *   alternates    the page in each framework, from `alternates()`. The
 *                 picker's framework items link there. Shell works it out
 *                 from `currentSlug` when it is left out.
 *
 * Slots: default fills everything right of the sidebar on desktop (the full
 * width under the header on phones), inside `<div id="content">`. The page
 * lays out its own column and right rail there. `head` goes to Layout.
 */
import { getDocs, toNavPage } from "@/lib/content";
import { AVAILABLE_FRAMEWORKS, type Framework } from "@/lib/frameworks";
import { alternates as alternatesFor, sidebar, type NavGroup } from "@/lib/nav";
import { INTRODUCTION_SLUG } from "@/lib/routes";
import type { PageMeta } from "@/lib/seo";
import { LATEST_VERSION } from "@/lib/versions";
import Layout from "@/layouts/Layout.astro";

import Search from "@/components/search/Search.astro";

import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { pickerItems, pickerVersion } from "./picker";
import Sidebar from "./Sidebar.astro";
import type { SidebarData } from "./sidebar";
import "./shell.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  meta?: PageMeta;
  framework?: Framework;
  version?: string;
  groups?: readonly NavGroup[];
  currentSlug?: string;
  alternates?: ReturnType<typeof alternatesFor>;
}

const {
  title,
  description,
  noindex,
  meta,
  framework,
  version = LATEST_VERSION,
  groups = [],
  currentSlug,
  alternates: others,
} = Astro.props;

let sidebars: SidebarData[];
if (framework) {
  const pageAlternates =
    others ?? alternatesFor((await getDocs()).map(toNavPage), currentSlug ?? INTRODUCTION_SLUG, version);
  const items = pickerItems({ framework, slug: currentSlug, alternates: pageAlternates });
  sidebars = [{ framework, version: pickerVersion(version), items, groups }];
} else {
  const pages = (await getDocs()).map(toNavPage);
  sidebars = AVAILABLE_FRAMEWORKS.map((id) => ({
    framework: id,
    version: pickerVersion(LATEST_VERSION),
    // Without alternates the framework items have no href, so picking one
    // swaps the sidebar and the page stays.
    items: pickerItems({ framework: id }),
    groups: sidebar(pages, id),
  }));
}
---

<Layout title={title} description={description} framework={framework} noindex={noindex} meta={meta}>
  <slot name="head" slot="head" />
  <a
    href="#content"
    class="sr-only z-50 rounded-md bg-background px-3 py-2 text-sm focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:ring-3 focus:ring-ring/30"
  >
    Skip to content
  </a>
  <Header framework={framework} sidebars={sidebars} currentSlug={currentSlug} />
  <Search />
  <div class="flex">
    {
      sidebars.map((data) => (
        <Sidebar {...data} currentSlug={currentSlug} switchable={sidebars.length > 1} />
      ))
    }
    <script is:inline>
      // Sidebar state. Runs before paint, right after the sidebar, on a full
      // load only (the client router doesn't rerun an inline script it has
      // seen), so it also hooks the router's events:
      // - Folded groups are remembered for the session. The current page's
      //   group stays open.
      // - The scroll position survives a full reload. Client-side navigations
      //   keep the nav itself (transition:persist in Sidebar.astro), scroll
      //   and all, so before the swap the kept nav takes the new page's
      //   current-page mark. Moving it resets its scrollTop, so that is put
      //   back after the swap.
      // - The current item is scrolled into view.
      (() => {
        const scrollKey = "forms:sidebar-scroll";
        const foldKey = "forms:sidebar-folded";
        // The IIFE is the scope; there is nothing outside it to move helpers to.
        /* oxlint-disable unicorn/consistent-function-scoping */
        const read = (key) => {
          try {
            return sessionStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const write = (key, value) => {
          try {
            sessionStorage.setItem(key, value);
          } catch {}
        };
        let folded = [];
        try {
          folded = JSON.parse(read(foldKey) ?? "[]");
        } catch {}
        const scrollers = () => [...document.querySelectorAll("[data-sidebar-scroll]")];

        const setUp = (scroller) => {
          if (scroller.dataset.ready !== undefined) return;
          scroller.dataset.ready = "";
          for (const group of scroller.querySelectorAll("[data-nav-group]")) {
            if (folded.includes(group.dataset.navGroup)) group.open = false;
            group.addEventListener("toggle", () => {
              const name = group.dataset.navGroup;
              folded = folded.filter((other) => other !== name);
              if (!group.open) folded.push(name);
              write(foldKey, JSON.stringify(folded));
            });
          }
        };
        const reveal = (scroller) => {
          const current = scroller.querySelector('[aria-current="page"]');
          if (!current) return;
          const group = current.closest("[data-nav-group]");
          if (group) group.open = true;
          const top = current.getBoundingClientRect().top - scroller.getBoundingClientRect().top + scroller.scrollTop;
          const bottom = top + current.offsetHeight;
          if (top < scroller.scrollTop || bottom > scroller.scrollTop + scroller.clientHeight) {
            scroller.scrollTop = top - scroller.clientHeight / 2;
          }
        };

        /* oxlint-enable unicorn/consistent-function-scoping */

        const saved = read(scrollKey);
        for (const scroller of scrollers()) {
          setUp(scroller);
          if (saved !== null) scroller.scrollTop = Number(saved);
          reveal(scroller);
        }
        addEventListener("pagehide", () => {
          const visible = scrollers().find((scroller) => scroller.getClientRects().length > 0);
          if (visible) write(scrollKey, String(visible.scrollTop));
        });

        const kept = new Map();
        document.addEventListener("astro:before-swap", (event) => {
          kept.clear();
          for (const scroller of scrollers()) {
            kept.set(scroller, scroller.scrollTop);
            const id = scroller.getAttribute("data-astro-transition-persist");
            const next = event.newDocument.querySelector(`[data-astro-transition-persist="${id}"]`);
            if (!next) continue;
            const href = next.querySelector('[aria-current="page"]')?.getAttribute("href");
            for (const link of scroller.querySelectorAll("a[href]")) {
              if (link.getAttribute("href") === href) link.setAttribute("aria-current", "page");
              else link.removeAttribute("aria-current");
            }
          }
        });
        document.addEventListener("astro:after-swap", () => {
          for (const scroller of scrollers()) {
            setUp(scroller);
            if (kept.has(scroller)) scroller.scrollTop = kept.get(scroller);
            reveal(scroller);
          }
          kept.clear();
        });
      })();
    </script>
    <script>
      import { attachNav } from "./rail";

      // Every page load, the first one too. A nav the router kept is already attached.
      document.addEventListener("astro:page-load", () => {
        for (const nav of document.querySelectorAll<HTMLElement>("[data-sidebar] [data-nav]")) attachNav(nav);
      });
    </script>
    <div id="content" class="min-w-0 flex-1">
      <slot />
      <Footer framework={framework} />
    </div>
  </div>
</Layout>
