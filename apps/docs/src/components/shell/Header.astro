---
/*
 * The sticky top bar. Desktop: wordmark, search field, GitHub, theme. Under
 * 1024px: menu button (MobileNav), wordmark, search icon, theme.
 *
 * Both search buttons carry `data-search-trigger`; components/search opens
 * the palette from it. The icon buttons are one island, HeaderActions. Both
 * islands persist across client-side navigations.
 */
import { SearchIcon } from "lucide-react";

import type { Framework } from "@/lib/frameworks";
import { frameworkHref } from "@/lib/routes";

import { HeaderActions } from "./HeaderActions";
import { LogoMark } from "./icons";
import { MobileNav } from "./MobileNav";
import type { SidebarData } from "./sidebar";

interface Props {
  framework?: Framework;
  sidebars: SidebarData[];
  currentSlug?: string;
}

const { framework, sidebars, currentSlug } = Astro.props;
const home = framework ? frameworkHref(framework) : "/";
const focusRing = "outline-none focus-visible:ring-3 focus-visible:ring-ring/30 focus-visible:border-ring";
const kbd = "inline-flex h-5 items-center rounded-sm border bg-background px-1 font-mono text-[11px] text-muted-foreground";
---

<header class="sticky top-0 z-40 flex h-14 items-center gap-2 border-b bg-background pr-3 pl-2.5 lg:px-6">
  <div class="lg:hidden">
    <MobileNav
      client:media="(max-width: 1023px)"
      transition:persist="mobile-nav"
      sidebars={sidebars}
      currentSlug={currentSlug}
    />
  </div>
  <a href={home} class:list={["flex items-center gap-2 rounded-md px-1 py-1 lg:-ml-1", focusRing]}>
    <LogoMark className="size-4.5" />
    <span class="font-mono text-base font-medium tracking-tight">forms</span>
  </a>
  <div class="ml-auto flex items-center gap-2 lg:gap-3">
    <button
      type="button"
      data-search-trigger
      class:list={[
        "hidden h-8 w-60 items-center gap-2 rounded-md border bg-background pr-1.5 pl-2.5 text-sm text-muted-foreground hover:bg-muted lg:flex",
        focusRing,
      ]}
    >
      <SearchIcon className="size-3.5" />
      Search
      <span class="ml-auto flex gap-1" aria-hidden="true">
        <kbd class={kbd}>Ctrl</kbd>
        <kbd class={kbd}>K</kbd>
      </span>
    </button>
    <HeaderActions client:idle transition:persist="header-actions" />
  </div>
</header>
