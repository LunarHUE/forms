---
/**
 * The trail above the title: section, then the page. Items with an href are
 * links; the last item is the page itself, darker and marked current.
 */
export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: readonly Crumb[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<nav data-pagefind-ignore aria-label="Breadcrumb" class={className}>
  <ol class="flex min-w-0 items-center gap-1.5 text-sm leading-5 text-muted-foreground">
    {
      items.map((item, index) => {
        const last = index === items.length - 1;
        return (
          <li class:list={["flex min-w-0 items-center gap-1.5", last ? "text-foreground" : "shrink-0"]}>
            {index > 0 && (
              <svg
                aria-hidden="true"
                class="size-3.5 shrink-0 text-muted-foreground"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m9 18 6-6-6-6" />
              </svg>
            )}
            {last ? (
              <span aria-current="page" class="truncate">
                {item.label}
              </span>
            ) : item.href ? (
              <a
                href={item.href}
                class="rounded-sm outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring/50"
              >
                {item.label}
              </a>
            ) : (
              <span>{item.label}</span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
