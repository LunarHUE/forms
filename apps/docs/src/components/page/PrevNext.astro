---
/**
 * Cards for the pages either side in the sidebar order. Next keeps the right
 * column even when there is no previous page.
 */
import type { NavItem } from "@/lib/nav";

interface Props {
  previous?: NavItem;
  next?: NavItem;
}

const { previous, next } = Astro.props;
const card =
  "group flex min-w-0 flex-col gap-1 rounded-lg border px-4 py-3.5 outline-none transition-colors hover:border-brand/50 hover:bg-muted/50 focus-visible:ring-2 focus-visible:ring-ring/50";
const arrow = "size-4 shrink-0 transition-transform motion-reduce:transition-none";
---

{
  (previous || next) && (
    <nav data-pagefind-ignore aria-label="Previous and next page" class="mt-8 grid grid-cols-2 gap-3 border-t pt-8 sm:gap-4">
      {previous && (
        <a href={previous.href} rel="prev" class={card}>
          <span class="text-[13px] leading-5 text-muted-foreground">Previous</span>
          <span class="flex items-center gap-1.5 font-medium text-brand">
            <svg aria-hidden="true" class:list={[arrow, "group-hover:-translate-x-0.5"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 19-7-7 7-7" />
              <path d="M19 12H5" />
            </svg>
            <span class="truncate">{previous.label}</span>
          </span>
        </a>
      )}
      {next && (
        <a href={next.href} rel="next" class:list={[card, "col-start-2 items-end text-right"]}>
          <span class="text-[13px] leading-5 text-muted-foreground">Next</span>
          <span class="flex max-w-full items-center gap-1.5 font-medium text-brand">
            <span class="truncate">{next.label}</span>
            <svg aria-hidden="true" class:list={[arrow, "group-hover:translate-x-0.5"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </span>
        </a>
      )}
    </nav>
  )
}
