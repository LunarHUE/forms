---
/**
 * A boxed aside in an MDX page.
 *
 *   <Callout>Plugins run in the order they are listed.</Callout>
 *   <Callout type="warning" title="Breaking in 0.2">`bind` takes the store first.</Callout>
 *
 * `note` (default) is tinted with the accent; `warning` is amber. Red stays
 * for errors. The body is Markdown and gets the article's prose styles.
 */
interface Props {
  type?: "note" | "warning";
  /** Bold first line. Without it the body starts beside the icon. */
  title?: string;
}

const { type = "note", title } = Astro.props;
const label = type === "warning" ? "Warning" : "Note";
---

<aside
  data-callout={type}
  aria-label={title ? undefined : label}
  class:list={[
    "my-5 flex gap-3 rounded-lg border px-4 py-3.5",
    type === "note" && "border-brand/25 bg-brand-tint",
    type === "warning" && "border-(--callout-warning-border) bg-(--callout-warning-bg)",
  ]}
>
  <svg
    aria-hidden="true"
    class:list={["mt-1 size-4 shrink-0", type === "note" ? "text-brand" : "text-(--callout-warning)"]}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {
      type === "warning" ? (
        <>
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
          <path d="M12 9v4" />
          <path d="M12 17h.01" />
        </>
      ) : (
        <>
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </>
      )
    }
  </svg>
  <div class="prose callout-body min-w-0 flex-1 text-[15px] leading-6">
    {title && <p class="font-semibold">{title}</p>}
    <slot />
  </div>
</aside>

<style>
  /* Tighter than the article: the box is the separation. */
  .callout-body > :global(*) {
    margin-block: 0.5rem;
    line-height: inherit;
    font-size: inherit;
  }
  .callout-body > :global(:first-child) {
    margin-top: 0;
  }
  .callout-body > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
