---
/*
 * The document every page renders into: <html>, <head> and <body>.
 *
 *   <Layout title="Masks · React" description="..." framework="react">
 *     ...page...
 *     <Fragment slot="head"><link rel="..." /></Fragment>
 *   </Layout>
 *
 * Props:
 *   title        the full <title>. " · LunarHUE Forms" is appended unless it is
 *                already "LunarHUE Forms".
 *   description  meta description, optional.
 *   framework    the framework the page is for, on framework pages. Sets
 *                html[data-framework] and saves it as the last-used framework.
 *   noindex      adds robots noindex (404, scratch pages).
 *   class        classes for <body>.
 *
 * Slots: default (the body), `head` (extra tags at the end of <head>).
 *
 * The inline boot script (lib/boot.ts) sets html.dark, data-theme, data-pm
 * and data-framework from localStorage before first paint. The server
 * markup carries the defaults (data-pm="bun", data-theme="system") so the
 * page also reads right without JavaScript.
 *
 * Every page carries the devtools dock (src/devtools), in production too.
 */
import type { Framework } from "@/lib/frameworks";
import { DevtoolsDock } from "@/devtools/DevtoolsDock";
import { bootScript } from "@/lib/boot";
import { DEFAULT_STATE } from "@/lib/store";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  framework?: Framework;
  noindex?: boolean;
  class?: string;
}

const SITE_NAME = "LunarHUE Forms";
const { title, description, framework, noindex = false, class: bodyClass } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
// `build.format: "file"` gives /react/install.html here; the public URL has no extension.
const pathname = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/";
const canonical = Astro.site ? new URL(pathname, Astro.site).href : undefined;
---

<html
  lang="en"
  data-theme={DEFAULT_STATE.theme}
  data-pm={DEFAULT_STATE.pm}
  data-framework={framework}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <script is:inline set:html={bootScript(framework ?? null)} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <DevtoolsDock client:idle />
  </body>
</html>
