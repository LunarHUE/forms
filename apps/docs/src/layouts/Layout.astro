---
/*
 * The document every page renders into: <html>, <head> and <body>.
 *
 *   <Layout title="Masks · React" description="..." framework="react">
 *     ...page...
 *     <Fragment slot="head"><link rel="..." /></Fragment>
 *   </Layout>
 *
 * Props:
 *   title        the full <title>. " · LunarHUE Forms" is appended unless it is
 *                already "LunarHUE Forms".
 *   description  meta description, optional.
 *   framework    the framework the page is for, on framework pages. Sets
 *                html[data-framework] and saves it as the last-used framework.
 *   noindex      adds robots noindex (the 404 page). Every page of the next
 *                site gets it anyway, and no canonical link.
 *   status       the HTTP status the page is served with, as html[data-status].
 *                Only the 404 page sets it; the pageview tracker reads it.
 *   meta         canonical path, Markdown copy, og:type, modified date and
 *                JSON-LD (lib/seo.ts). The canonical defaults to the page's
 *                own URL.
 *   class        classes for <body>.
 *
 * Slots: default (the body), `head` (extra tags at the end of <head>).
 *
 * Astro's client router swaps pages in place, so the stylesheet and fonts
 * load once. Shell marks the header's and sidebar's islands with
 * `transition:persist`. The two Latin font files are preloaded so the first
 * load shows the right fonts sooner.
 *
 * The inline boot script (lib/boot.ts) sets html.dark, data-theme, data-pm,
 * data-framework and data-devtools from localStorage before first paint. The server
 * markup carries the defaults (data-pm="bun", data-theme="system") so the
 * page also reads right without JavaScript.
 *
 * lib/edge-fade.ts fades the edges of scroll areas marked `data-edge-fade`.
 * lib/analytics.ts reports pageviews on the public sites. Cloudflare Web
 * Analytics' beacon loads only when the build has CF_WEB_ANALYTICS_TOKEN.
 * The build copies it to /_/b.js (integrations/cf-beacon.ts) and it posts
 * to /_/r (functions/_/r.ts), so blocklists that match Cloudflare's hosts
 * don't stop it.
 */
import { ClientRouter } from "astro:transitions";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import geistMonoLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

import type { Framework } from "@/lib/frameworks";
import { bootScript } from "@/lib/boot";
import { jsonForScript, type PageMeta } from "@/lib/seo";
import { CF_WEB_ANALYTICS_TOKEN, CHANNEL, SITE_NAME } from "@/lib/site";
import { DEFAULT_STATE } from "@/lib/store";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  framework?: Framework;
  noindex?: boolean;
  status?: number;
  meta?: PageMeta;
  class?: string;
}

const {
  title,
  description,
  framework,
  noindex: pageNoindex = false,
  status,
  meta = {},
  class: bodyClass,
} = Astro.props;
// The next site documents unreleased APIs, so search engines only see production.
const noindex = pageNoindex || CHANNEL === "next";
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
// `build.format: "file"` gives /react/install.html here; the public URL has no extension.
const pathname = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/";
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const url = absolute(pathname);
const canonical = absolute(meta.canonical ?? pathname);
---

<html
  lang="en"
  transition:animate="none"
  data-theme={DEFAULT_STATE.theme}
  data-pm={DEFAULT_STATE.pm}
  data-devtools="on"
  data-framework={framework}
  data-status={status}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {meta.markdown && <link rel="alternate" type="text/markdown" href={meta.markdown} title="This page as Markdown" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Docs index for language models" />
    {!noindex && <link rel="sitemap" type="application/xml" href="/sitemap.xml" />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={meta.type ?? "website"} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="en_US" />
    {meta.modified && <meta property="article:modified_time" content={meta.modified.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {
      meta.structuredData?.map((data) => (
        <script is:inline type="application/ld+json" set:html={jsonForScript(data)} />
      ))
    }
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={bootScript(framework ?? null)} />
    <ClientRouter />
    {
      CF_WEB_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="/_/b.js"
          data-cf-beacon={JSON.stringify({ token: CF_WEB_ANALYTICS_TOKEN, spa: true, send: { to: "/_/r" } })}
        />
      )
    }
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      // Soft edges on scroll areas and pageviews. Bundled, so it runs once and
      // outlives page swaps.
      import { startAnalytics } from "@/lib/analytics";
      import { startEdgeFade } from "@/lib/edge-fade";

      startEdgeFade();
      startAnalytics();
    </script>
  </body>
</html>
