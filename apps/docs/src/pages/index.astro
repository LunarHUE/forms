---
import { AVAILABLE_FRAMEWORKS, DEFAULT_FRAMEWORK } from "@/lib/frameworks";
import { frameworkHref } from "@/lib/routes";

// `/` opens the Introduction of the framework the visitor used last.
const hrefs = Object.fromEntries(AVAILABLE_FRAMEWORKS.map((framework) => [framework, frameworkHref(framework)]));
const fallback = frameworkHref(DEFAULT_FRAMEWORK);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LunarHUE Forms</title>
    <script is:inline define:vars={{ hrefs, fallback }}>
      let last = null;
      try {
        last = localStorage.getItem("forms:framework");
      } catch {}
      location.replace((last && hrefs[last]) || fallback);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${fallback}`} /></noscript>
  </head>
  <body>
    <p><a href={fallback}>LunarHUE Forms docs</a></p>
  </body>
</html>
