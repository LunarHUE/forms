---
import UiShowcase from "@/components/scratch/UiShowcase";
import "@/styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>UI scratch</title>
  </head>
  <body>
    <header class="flex items-center justify-between border-b px-6 py-3">
      <span class="font-mono text-sm">forms / scratch / ui</span>
      <!-- Popups render in a portal on body, so they only turn dark with .dark on html. -->
      <button id="toggle-dark" class="rounded-md border px-3 py-1 text-sm hover:bg-accent">Toggle html.dark</button>
    </header>
    <main class="grid grid-cols-1 lg:grid-cols-2">
      <div class="p-8">
        <UiShowcase client:load />
      </div>
      <div class="dark bg-background p-8 text-foreground">
        <UiShowcase client:load framework="solid" />
      </div>
    </main>
    <script>
      document.getElementById("toggle-dark")?.addEventListener("click", () => {
        document.documentElement.classList.toggle("dark");
      });
    </script>
  </body>
</html>
