---
// Throwaway proof for item 0.2: one demo per framework, with reset.
import ReactContact from "../../demos/react/masks/contact/contact";
import SolidContact from "../../demos/solid/masks/contact/contact";
import ResetStage from "./_ResetStage.astro";

export function getStaticPaths() {
  return [{ params: { framework: "react" } }, { params: { framework: "solid" } }];
}

const { framework } = Astro.params;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Proof: {framework}</title>
  </head>
  <body>
    <h1>{framework}</h1>
    <ResetStage>
      {framework === "react" ? <ReactContact client:visible /> : <SolidContact client:visible />}
    </ResetStage>
  </body>
</html>
