---
import Layout from "@/layouts/Layout.astro";
import { DEFAULT_FRAMEWORK } from "@/lib/frameworks";
import { frameworkHref } from "@/lib/routes";
---

<Layout title="Page not found" noindex>
  <main>
    <h1>Page not found</h1>
    <p>No page lives at this address.</p>
    <p><a href={frameworkHref(DEFAULT_FRAMEWORK)}>Go to the introduction</a></p>
  </main>
</Layout>
