---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import { mdxComponents } from "@/components/mdx";
import Article from "@/components/page/Article.astro";
import Shell from "@/components/shell/Shell.astro";
import { getDocs, toNavPage, type DocEntry } from "@/lib/content";
import { AVAILABLE_FRAMEWORKS, frameworkLabel, type Framework } from "@/lib/frameworks";
import { lastCommitDate } from "@/lib/git";
import { headingsFor } from "@/lib/mdx/framework-blocks";
import { alternates, pagination, SECTION_LABELS, sidebar } from "@/lib/nav";
import { markdownHref } from "@/lib/pages";
import { docHref } from "@/lib/routes";
import { docData, type PageMeta } from "@/lib/seo";
import { LATEST_VERSION, VERSIONS } from "@/lib/versions";

export const getStaticPaths = (async () => {
  const entries = await getDocs();
  const pages = entries.map(toNavPage);
  return VERSIONS.flatMap(({ id: version }) =>
    AVAILABLE_FRAMEWORKS.flatMap((framework) => {
      const groups = sidebar(pages, framework, version);
      return entries
        .filter((entry) => entry.data.frameworks.includes(framework))
        .map((entry) => {
          // The rest param carries the version segment of an older version.
          const href = docHref({ framework, version, slug: entry.id });
          return {
            params: { framework, slug: href.slice(`/${framework}/`.length) },
            props: {
              entry,
              framework,
              version,
              sidebar: groups,
              ...pagination(groups, entry.id),
              alternates: alternates(pages, entry.id, version),
            },
          };
        });
    }),
  );
}) satisfies GetStaticPaths;

interface Props {
  entry: DocEntry;
  framework: Framework;
  version: string;
  sidebar: ReturnType<typeof sidebar>;
  previous?: ReturnType<typeof pagination>["previous"];
  next?: ReturnType<typeof pagination>["next"];
  alternates: ReturnType<typeof alternates>;
}

const { entry, framework, version, sidebar: groups, previous, next, alternates: others } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const { title, description, section } = entry.data;
// Search (integrations/pagefind.ts) indexes the latest version only. The
// framework filter keeps a React search to React pages; the section names the
// result's path, as in "Plugins / Masks".

// Each framework's page is its own canonical: the prose matches but the code
// differs, and a Solid search should land on the Solid page. An older
// version points at the latest copy of its page.
const latest = docHref({ framework, slug: entry.id });
const lastUpdated = entry.filePath ? lastCommitDate(entry.filePath) : undefined;
const markdown = version === LATEST_VERSION ? markdownHref(latest) : undefined;
const meta: PageMeta = {
  canonical: latest,
  markdown,
  type: "article",
  modified: lastUpdated,
  structuredData: docData({
    title,
    description,
    href: latest,
    framework,
    section: SECTION_LABELS[section],
    modified: lastUpdated,
  }),
};
---

<Shell
  title={`${title} · ${frameworkLabel(framework)}`}
  description={description}
  meta={meta}
  framework={framework}
  version={version}
  groups={groups}
  currentSlug={entry.id}
  alternates={others}
>
  <main
    data-pagefind-body={version === LATEST_VERSION ? "" : undefined}
    data-pagefind-filter={`framework:${framework}`}
    data-pagefind-meta={`section:${SECTION_LABELS[section]}`}
  >
    <Article
      title={title}
      description={description}
      breadcrumb={[{ label: SECTION_LABELS[section] }, { label: title }]}
      headings={headingsFor(framework, headings, remarkPluginFrontmatter)}
      previous={previous}
      next={next}
      markdown={markdown}
      lastUpdated={lastUpdated}
    >
      <Content components={mdxComponents} />
    </Article>
  </main>
</Shell>
