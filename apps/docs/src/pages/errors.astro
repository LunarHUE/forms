---
import { render } from "astro:content";

import { mdxComponents } from "@/components/mdx";
import Shell from "@/components/shell/Shell.astro";
import { getErrors } from "@/lib/content";
import { errorAnchors } from "@/lib/errors";
import { errorsHref } from "@/lib/routes";

// Bare markup inside the shell until the page frame replaces it.
const entry = await getErrors();
const { Content } = await render(entry);
const { title, description } = entry.data;
const anchors = errorAnchors(entry.body ?? "");
---

<Shell title={title} description={description} currentSlug="errors">
  <main>
    <h1>{title}</h1>
    <p>{description}</p>
    <nav aria-label="Error codes">
      <ul>
        {
          anchors.map((anchor) => (
            <li>
              <a href={errorsHref(anchor.id)}>
                {anchor.package} <code>{anchor.code}</code>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <Content components={mdxComponents} />
  </main>
</Shell>
