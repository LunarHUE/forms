{
  "name": "@lunarhue/forms-solid",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunarHUE/forms.git",
    "directory": "packages/solid"
  },
  "files": [
    "dist",
    "v1",
    "plugins"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "@lunarhue/source": "./src/index.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./v1": {
      "@lunarhue/source": "./src/v1.ts",
      "import": {
        "types": "./dist/esm/v1.d.ts",
        "default": "./dist/esm/v1.js"
      },
      "require": {
        "types": "./dist/cjs/v1.d.ts",
        "default": "./dist/cjs/v1.js"
      }
    },
    "./plugins": {
      "@lunarhue/source": "./src/plugins.ts",
      "import": {
        "types": "./dist/esm/plugins.d.ts",
        "default": "./dist/esm/plugins.js"
      },
      "require": {
        "types": "./dist/cjs/plugins.d.ts",
        "default": "./dist/cjs/plugins.js"
      }
    },
    "./plugins/history": {
      "@lunarhue/source": "./src/plugins/history.ts",
      "import": {
        "types": "./dist/esm/plugins/history.d.ts",
        "default": "./dist/esm/plugins/history.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/history.d.ts",
        "default": "./dist/cjs/plugins/history.js"
      }
    },
    "./plugins/mask": {
      "@lunarhue/source": "./src/plugins/mask.ts",
      "import": {
        "types": "./dist/esm/plugins/mask.d.ts",
        "default": "./dist/esm/plugins/mask.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/mask.d.ts",
        "default": "./dist/cjs/plugins/mask.js"
      }
    },
    "./plugins/persist": {
      "@lunarhue/source": "./src/plugins/persist.ts",
      "import": {
        "types": "./dist/esm/plugins/persist.d.ts",
        "default": "./dist/esm/plugins/persist.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/persist.d.ts",
        "default": "./dist/cjs/plugins/persist.js"
      }
    },
    "./plugins/rebase": {
      "@lunarhue/source": "./src/plugins/rebase.ts",
      "import": {
        "types": "./dist/esm/plugins/rebase.d.ts",
        "default": "./dist/esm/plugins/rebase.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/rebase.d.ts",
        "default": "./dist/cjs/plugins/rebase.js"
      }
    },
    "./plugins/rules": {
      "@lunarhue/source": "./src/plugins/rules.ts",
      "import": {
        "types": "./dist/esm/plugins/rules.d.ts",
        "default": "./dist/esm/plugins/rules.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/rules.d.ts",
        "default": "./dist/cjs/plugins/rules.js"
      }
    },
    "./plugins/validation": {
      "@lunarhue/source": "./src/plugins/validation.ts",
      "import": {
        "types": "./dist/esm/plugins/validation.d.ts",
        "default": "./dist/esm/plugins/validation.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/validation.d.ts",
        "default": "./dist/cjs/plugins/validation.js"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@lunarhue/forms-core": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0 || ^2.0.0-rc.0",
    "@solidjs/web": "^2.0.0-rc.0"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lunarhue/forms-schema": "workspace:^",
    "@solidjs/vite-plugin": "catalog:",
    "@solidjs/web": "catalog:",
    "jsdom": "catalog:",
    "solid-js": "catalog:",
    "valibot": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --outDir dist/cjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict --pack npm && attw --pack .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": ".",
      "path": "dist/esm/index.js",
      "import": "*",
      "limit": "11 kB"
    },
    {
      "name": "./v1",
      "path": "dist/esm/v1.js",
      "import": "*",
      "limit": "8 kB"
    },
    {
      "name": "solid + valibot()",
      "import": {
        "dist/esm/index.js": "*",
        "../schema/dist/esm/valibot.js": "{ valibot }"
      },
      "limit": "13.5 kB"
    }
  ]
}
