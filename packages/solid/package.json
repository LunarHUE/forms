{
  "name": "@lunarhue/forms-solid",
  "license": "MIT",
  "version": "0.1.1",
  "description": "Type-safe forms for Solid, with features as plugins.",
  "keywords": ["form", "forms", "solid", "solid-js", "typescript", "validation"],
  "homepage": "https://github.com/LunarHUE/forms#readme",
  "bugs": "https://github.com/LunarHUE/forms/issues",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunarHUE/forms.git",
    "directory": "packages/solid"
  },
  "files": [
    "dist",
    "v1",
    "plugins"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "imports": {
    "#solid": {
      "@lunarhue/solid1": "./src/solid1.ts",
      "default": "./src/solid2.ts"
    }
  },
  "exports": {
    ".": {
      "@lunarhue/source": "./src/index.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./v1": {
      "@lunarhue/source": "./src/index.ts",
      "import": {
        "types": "./dist/v1/esm/index.d.ts",
        "default": "./dist/v1/esm/index.js"
      },
      "require": {
        "types": "./dist/v1/cjs/index.d.ts",
        "default": "./dist/v1/cjs/index.js"
      }
    },
    "./plugins": {
      "@lunarhue/source": "./src/plugins.ts",
      "import": {
        "types": "./dist/esm/plugins.d.ts",
        "default": "./dist/esm/plugins.js"
      },
      "require": {
        "types": "./dist/cjs/plugins.d.ts",
        "default": "./dist/cjs/plugins.js"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@lunarhue/forms-core": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0 || ^2.0.0",
    "@solidjs/web": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lunarhue/forms-schema": "workspace:^",
    "@solidjs/vite-plugin": "catalog:",
    "@solidjs/web": "catalog:",
    "jsdom": "catalog:",
    "solid-js": "catalog:",
    "valibot": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && tsdown -c tsdown.types.config.ts && rm -rf dist/types",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.v1.json",
    "check:package": "publint --strict --pack npm && attw --pack .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "solid, fields bound by hand",
      "import": {
        "dist/esm/index.js": "{ createForms, createForm }"
      },
      "limit": "11.4 kB"
    },
    {
      "name": "solid + inputProps",
      "import": {
        "dist/esm/index.js": "{ createForms, createForm, inputProps }"
      },
      "limit": "12.2 kB"
    },
    {
      "name": ".",
      "path": "dist/esm/index.js",
      "import": "*",
      "limit": "12.75 kB"
    },
    {
      "name": "./v1",
      "path": "dist/v1/esm/index.js",
      "import": "*",
      "limit": "12.8 kB"
    },
    {
      "name": "solid + valibot()",
      "import": {
        "dist/esm/index.js": "*",
        "../schema/dist/esm/valibot.js": "{ valibot }"
      },
      "limit": "13.2 kB"
    },
    {
      "name": "solid + dirty()",
      "import": {
        "dist/esm/index.js": "*",
        "dist/esm/plugins.js": "{ dirty }"
      },
      "limit": "13.35 kB"
    },
    {
      "name": "solid, everything on",
      "import": {
        "dist/esm/index.js": "*",
        "../schema/dist/esm/valibot.js": "{ valibot }",
        "dist/esm/plugins.js": "{ history, mask, persist, rules, rebase, bind, dirty, baselineOnSubmit }"
      }
    }
  ]
}
