{
  "name": "@lunarhue/forms-react",
  "license": "MIT",
  "version": "0.1.1",
  "description": "Type-safe forms for React, with features as plugins.",
  "keywords": ["form", "forms", "react", "react-hooks", "typescript", "validation"],
  "homepage": "https://github.com/LunarHUE/forms#readme",
  "bugs": "https://github.com/LunarHUE/forms/issues",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunarHUE/forms.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "plugins"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "@lunarhue/source": "./src/index.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./plugins": {
      "@lunarhue/source": "./src/plugins.ts",
      "import": {
        "types": "./dist/esm/plugins.d.ts",
        "default": "./dist/esm/plugins.js"
      },
      "require": {
        "types": "./dist/cjs/plugins.d.ts",
        "default": "./dist/cjs/plugins.js"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@lunarhue/forms-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && tsdown -c tsdown.types.config.ts && rm -rf dist/types",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict --pack npm && attw --pack .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "react, fields bound by hand",
      "import": {
        "dist/esm/index.js": "{ createForms, useForm }"
      },
      "limit": "11.8 kB"
    },
    {
      "name": "react + inputProps",
      "import": {
        "dist/esm/index.js": "{ createForms, useForm, inputProps }"
      },
      "limit": "12.35 kB"
    },
    {
      "path": "dist/esm/index.js",
      "import": "*",
      "limit": "12.85 kB"
    },
    {
      "name": "react + valibot()",
      "import": {
        "dist/esm/index.js": "*",
        "../schema/dist/esm/valibot.js": "{ valibot }"
      },
      "limit": "13.35 kB"
    },
    {
      "name": "react + dirty()",
      "import": {
        "dist/esm/index.js": "*",
        "dist/esm/plugins.js": "{ dirty }"
      },
      "limit": "13.45 kB"
    },
    {
      "name": "react, everything on",
      "import": {
        "dist/esm/index.js": "*",
        "../schema/dist/esm/valibot.js": "{ valibot }",
        "dist/esm/plugins.js": "{ history, mask, persist, rules, rebase, bind, dirty, baselineOnSubmit }"
      }
    }
  ]
}
