{
  "name": "@lunarhue/forms-react",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "./dist/*/legacy.js",
    "./src/legacy.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunarHUE/forms.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "legacy",
    "plugins"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "@lunarhue/source": "./src/index.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./legacy": {
      "@lunarhue/source": "./src/legacy.ts",
      "import": {
        "types": "./dist/esm/legacy.d.ts",
        "default": "./dist/esm/legacy.js"
      },
      "require": {
        "types": "./dist/cjs/legacy.d.ts",
        "default": "./dist/cjs/legacy.js"
      }
    },
    "./plugins": {
      "@lunarhue/source": "./src/plugins.ts",
      "import": {
        "types": "./dist/esm/plugins.d.ts",
        "default": "./dist/esm/plugins.js"
      },
      "require": {
        "types": "./dist/cjs/plugins.d.ts",
        "default": "./dist/cjs/plugins.js"
      }
    },
    "./plugins/bind": {
      "@lunarhue/source": "./src/plugins/bind.ts",
      "import": {
        "types": "./dist/esm/plugins/bind.d.ts",
        "default": "./dist/esm/plugins/bind.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/bind.d.ts",
        "default": "./dist/cjs/plugins/bind.js"
      }
    },
    "./plugins/dirty": {
      "@lunarhue/source": "./src/plugins/dirty.ts",
      "import": {
        "types": "./dist/esm/plugins/dirty.d.ts",
        "default": "./dist/esm/plugins/dirty.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/dirty.d.ts",
        "default": "./dist/cjs/plugins/dirty.js"
      }
    },
    "./plugins/history": {
      "@lunarhue/source": "./src/plugins/history.ts",
      "import": {
        "types": "./dist/esm/plugins/history.d.ts",
        "default": "./dist/esm/plugins/history.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/history.d.ts",
        "default": "./dist/cjs/plugins/history.js"
      }
    },
    "./plugins/mask": {
      "@lunarhue/source": "./src/plugins/mask.ts",
      "import": {
        "types": "./dist/esm/plugins/mask.d.ts",
        "default": "./dist/esm/plugins/mask.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/mask.d.ts",
        "default": "./dist/cjs/plugins/mask.js"
      }
    },
    "./plugins/persist": {
      "@lunarhue/source": "./src/plugins/persist.ts",
      "import": {
        "types": "./dist/esm/plugins/persist.d.ts",
        "default": "./dist/esm/plugins/persist.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/persist.d.ts",
        "default": "./dist/cjs/plugins/persist.js"
      }
    },
    "./plugins/rebase": {
      "@lunarhue/source": "./src/plugins/rebase.ts",
      "import": {
        "types": "./dist/esm/plugins/rebase.d.ts",
        "default": "./dist/esm/plugins/rebase.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/rebase.d.ts",
        "default": "./dist/cjs/plugins/rebase.js"
      }
    },
    "./plugins/rules": {
      "@lunarhue/source": "./src/plugins/rules.ts",
      "import": {
        "types": "./dist/esm/plugins/rules.d.ts",
        "default": "./dist/esm/plugins/rules.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/rules.d.ts",
        "default": "./dist/cjs/plugins/rules.js"
      }
    },
    "./plugins/validation": {
      "@lunarhue/source": "./src/plugins/validation.ts",
      "import": {
        "types": "./dist/esm/plugins/validation.d.ts",
        "default": "./dist/esm/plugins/validation.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/validation.d.ts",
        "default": "./dist/cjs/plugins/validation.js"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@lunarhue/forms-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --outDir dist/cjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict --pack npm && attw --pack .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "react",
      "path": "dist/esm/index.js",
      "import": "*",
      "limit": "10.8 kB"
    },
    {
      "name": "react + valibot()",
      "import": {
        "dist/esm/index.js": "*",
        "../schema/dist/esm/valibot.js": "{ valibot }"
      },
      "limit": "13.55 kB"
    },
    {
      "name": "react + dirty()",
      "import": {
        "dist/esm/index.js": "*",
        "dist/esm/plugins/dirty.js": "{ dirty }"
      },
      "limit": "11.05 kB"
    },
    {
      "name": "react/legacy",
      "path": "dist/esm/legacy.js",
      "import": "*",
      "limit": "11 kB"
    },
    {
      "name": "react/legacy + valibot()",
      "import": {
        "dist/esm/legacy.js": "*",
        "../schema/dist/esm/valibot.js": "{ valibot }"
      },
      "limit": "13.75 kB"
    },
    {
      "name": "react, everything on",
      "import": {
        "dist/esm/index.js": "*",
        "../schema/dist/esm/valibot.js": "{ valibot }",
        "dist/esm/plugins/history.js": "{ history }",
        "dist/esm/plugins/mask.js": "{ mask }",
        "dist/esm/plugins/persist.js": "{ persist }",
        "dist/esm/plugins/rules.js": "{ rules }",
        "dist/esm/plugins/rebase.js": "{ rebase }",
        "dist/esm/plugins/bind.js": "{ bind }",
        "dist/esm/plugins/dirty.js": "{ dirty }"
      },
      "limit": "16.3 kB"
    }
  ]
}
