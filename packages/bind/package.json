{
  "name": "@lunarhue/forms-bind",
  "license": "MIT",
  "version": "0.1.1",
  "description": "Bind a forms form to a Zustand store or a Solid signal.",
  "keywords": ["form", "forms", "zustand", "solid", "state"],
  "homepage": "https://github.com/LunarHUE/forms#readme",
  "bugs": "https://github.com/LunarHUE/forms/issues",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunarHUE/forms.git",
    "directory": "packages/bind"
  },
  "files": [
    "dist",
    "solid",
    "zustand"
  ],
  "exports": {
    "./solid": {
      "@lunarhue/source": "./src/solid.ts",
      "import": {
        "types": "./dist/esm/solid.d.ts",
        "default": "./dist/esm/solid.js"
      },
      "require": {
        "types": "./dist/cjs/solid.d.ts",
        "default": "./dist/cjs/solid.js"
      }
    },
    "./zustand": {
      "@lunarhue/source": "./src/zustand.ts",
      "import": {
        "types": "./dist/esm/zustand.d.ts",
        "default": "./dist/esm/zustand.js"
      },
      "require": {
        "types": "./dist/cjs/zustand.d.ts",
        "default": "./dist/cjs/zustand.js"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@lunarhue/forms-core": "workspace:^",
    "solid-js": "^2.0.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lunarhue/forms-core": "workspace:^",
    "solid-js": "catalog:",
    "zustand": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --outDir dist/cjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict --pack npm && attw --pack .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "./solid",
      "path": "dist/esm/solid.js",
      "import": "*",
      "limit": "350 B"
    },
    {
      "name": "./zustand",
      "path": "dist/esm/zustand.js",
      "import": "*",
      "limit": "350 B"
    },
    {
      "name": "core + signal()",
      "import": {
        "../core/dist/esm/index.js": "{ createFormsCore }",
        "../core/dist/esm/plugins/bind.js": "{ bind }",
        "dist/esm/solid.js": "{ signal }"
      },
      "limit": "11.6 kB"
    },
    {
      "name": "core + zustand()",
      "import": {
        "../core/dist/esm/index.js": "{ createFormsCore }",
        "../core/dist/esm/plugins/bind.js": "{ bind }",
        "dist/esm/zustand.js": "{ zustand }"
      },
      "limit": "11.6 kB"
    }
  ]
}
