{
  "name": "@lunarhue/forms-core",
  "license": "MIT",
  "version": "0.1.1",
  "description": "The framework-free core of forms: values, arrays, submit and plugins.",
  "keywords": ["form", "forms", "headless", "typescript", "validation"],
  "homepage": "https://github.com/LunarHUE/forms#readme",
  "bugs": "https://github.com/LunarHUE/forms/issues",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunarHUE/forms.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "plugins"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "@lunarhue/source": "./src/index.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./plugins": {
      "@lunarhue/source": "./src/plugins/index.ts",
      "import": {
        "types": "./dist/esm/plugins/index.d.ts",
        "default": "./dist/esm/plugins/index.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/index.d.ts",
        "default": "./dist/cjs/plugins/index.js"
      }
    },
    "./plugins/testing": {
      "@lunarhue/source": "./src/plugins/testing.ts",
      "import": {
        "types": "./dist/esm/plugins/testing.d.ts",
        "default": "./dist/esm/plugins/testing.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/testing.d.ts",
        "default": "./dist/cjs/plugins/testing.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --outDir dist/cjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict --pack npm && attw --pack .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": ".",
      "path": "dist/esm/index.js",
      "import": "*",
      "limit": "9.45 kB"
    },
    {
      "name": "./plugins, plugin authoring",
      "path": "dist/esm/plugins/index.js",
      "import": "{ definePlugin, flushPlugins, refuse }",
      "limit": "3.5 kB"
    },
    {
      "name": "./plugins dirty()",
      "path": "dist/esm/plugins/index.js",
      "import": "{ dirty }",
      "limit": "1.2 kB"
    },
    {
      "name": "./plugins bind()",
      "path": "dist/esm/plugins/index.js",
      "import": "{ bind }",
      "limit": "3.15 kB"
    },
    {
      "name": "./plugins history()",
      "path": "dist/esm/plugins/index.js",
      "import": "{ history }",
      "limit": "2.85 kB"
    },
    {
      "name": "./plugins mask()",
      "path": "dist/esm/plugins/index.js",
      "import": "{ mask }",
      "limit": "3.5 kB"
    },
    {
      "name": "./plugins persist()",
      "path": "dist/esm/plugins/index.js",
      "import": "{ persist }",
      "limit": "2.7 kB"
    },
    {
      "name": "./plugins rebase()",
      "path": "dist/esm/plugins/index.js",
      "import": "{ rebase }",
      "limit": "2.95 kB"
    },
    {
      "name": "./plugins rules()",
      "path": "dist/esm/plugins/index.js",
      "import": "{ rules }",
      "limit": "3.45 kB"
    },
    {
      "name": "./plugins/testing",
      "path": "dist/esm/plugins/testing.js",
      "import": "{ testStore }",
      "limit": "12.05 kB"
    },
    {
      "name": "history() + mask()",
      "path": "dist/esm/plugins/index.js",
      "import": "{ history, mask }",
      "limit": "4.0 kB"
    },
    {
      "name": "core + dirty()",
      "import": {
        "dist/esm/index.js": "*",
        "dist/esm/plugins/index.js": "{ dirty }"
      },
      "limit": "10.05 kB"
    },
    {
      "name": "dirty() + baselineOnSubmit()",
      "path": "dist/esm/plugins/index.js",
      "import": "{ dirty, baselineOnSubmit }",
      "limit": "3.75 kB"
    }
  ]
}
