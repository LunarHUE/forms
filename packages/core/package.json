{
  "name": "@lunarhue/forms-core",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunarHUE/forms.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "plugins",
    "validation"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "@lunarhue/source": "./src/index.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./plugins": {
      "@lunarhue/source": "./src/plugins.ts",
      "import": {
        "types": "./dist/esm/plugins.d.ts",
        "default": "./dist/esm/plugins.js"
      },
      "require": {
        "types": "./dist/cjs/plugins.d.ts",
        "default": "./dist/cjs/plugins.js"
      }
    },
    "./plugins/rebase": {
      "@lunarhue/source": "./src/plugins/rebase.ts",
      "import": {
        "types": "./dist/esm/plugins/rebase.d.ts",
        "default": "./dist/esm/plugins/rebase.js"
      },
      "require": {
        "types": "./dist/cjs/plugins/rebase.d.ts",
        "default": "./dist/cjs/plugins/rebase.js"
      }
    },
    "./validation": {
      "@lunarhue/source": "./src/validation.ts",
      "import": {
        "types": "./dist/esm/validation.d.ts",
        "default": "./dist/esm/validation.js"
      },
      "require": {
        "types": "./dist/cjs/validation.d.ts",
        "default": "./dist/cjs/validation.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --outDir dist/cjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict --pack npm && attw --pack .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": ".",
      "path": "dist/esm/index.js",
      "import": "*",
      "limit": "8 kB"
    },
    {
      "name": "./plugins",
      "path": "dist/esm/plugins.js",
      "import": "*",
      "limit": "1.8 kB"
    },
    {
      "name": "./plugins/rebase",
      "path": "dist/esm/plugins/rebase.js",
      "import": "*",
      "limit": "2.4 kB"
    },
    {
      "name": "./validation",
      "path": "dist/esm/validation.js",
      "import": "*",
      "limit": "3.1 kB"
    }
  ]
}
