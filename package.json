{
  "name": "@lunarhue/forms-monorepo",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/react/compat/*",
      "apps/*",
      "examples/*/*"
    ],
    "catalog": {
      "@arethetypeswrong/cli": "0.18.5",
      "@babel/core": "7.29.13",
      "@changesets/cli": "3.0.3",
      "@playwright/test": "1.65.0",
      "@size-limit/preset-small-lib": "14.3.0",
      "@solidjs/vite-plugin": "3.0.0-next.57",
      "@solidjs/web": "2.0.0-rc.21",
      "@testing-library/dom": "10.4.2",
      "@testing-library/react": "16.3.3",
      "@testing-library/user-event": "14.6.8",
      "@types/babel__core": "7.20.5",
      "@types/node": "24.9.2",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "babel-plugin-react-compiler": "1.0.0",
      "eslint-plugin-react-hooks": "7.1.1",
      "jsdom": "31.0.0",
      "next": "16.4.6",
      "oxlint": "1.93.0",
      "oxlint-tsgolint": "7.0.2007",
      "publint": "0.3.25",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "size-limit": "14.3.0",
      "solid-js": "2.0.0-rc.21",
      "tsdown": "0.23.7",
      "typescript": "7.0.2",
      "valibot": "1.5.0",
      "vite": "8.3.8",
      "vitest": "5.1.0",
      "zod": "4.6.7"
    },
    "catalogs": {
      "react16": {
        "react": "16.8.0",
        "react-dom": "16.8.0"
      },
      "react17": {
        "react": "17.0.2",
        "react-dom": "17.0.2"
      },
      "react18": {
        "react": "18.3.1",
        "react-dom": "18.3.1"
      }
    }
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "tsc -p tsconfig.json && bun run --filter './packages/*' --filter './examples/*/*' typecheck",
    "lint": "oxlint",
    "test": "vitest run",
    "check:package": "bun run --filter './packages/*' check:package",
    "size": "bun run --filter './packages/*' size",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
