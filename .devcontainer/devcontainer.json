{
  "name": "forms",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers-extra/features/bun:1": {}
  },
  // Install workspace dependencies and Playwright's Chromium + system libraries
  // so both the unit checks and the browser e2e suite work out of the box.
  "postCreateCommand": "bun install --frozen-lockfile && (cd e2e && bunx playwright install --with-deps chromium)",
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode"]
    }
  }
}
